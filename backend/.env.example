NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CARVEO_LOG_LEVEL=INFO
CARVEO_BEAT_INTERVAL_SECONDS=30
CARVEO_BEAT_HEARTBEAT_TTL_SECONDS=90
