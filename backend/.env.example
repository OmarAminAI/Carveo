POSTGRES_DB=carveo
POSTGRES_USER=carveo
POSTGRES_PASSWORD=change-me
CARVEO_DATABASE_URL=postgresql+psycopg://carveo:change-me@postgres:5432/carveo
CARVEO_REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=carveo-local
MINIO_ROOT_PASSWORD=replace-with-a-local-random-minio-password
CARVEO_OBJECT_STORAGE_BUCKET=carveo-media
CARVEO_CORS_ORIGINS=["http://localhost:3000"]
CARVEO_CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
CARVEO_CLERK_SECRET_KEY=sk_test_replace-with-clerk-secret-key
# CARVEO_CLERK_JWT_KEY=replace-with-clerk-jwt-public-key
CARVEO_CATALOGUE_SOURCE=api
CARVEO_API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_CARVEO_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-clerk-secret-key
